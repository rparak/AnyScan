# Python bytecode / caches
__pycache__/
*.py[cod]

# Virtual environments
.venv/
venv/
env/

# macOS
.DS_Store

# Model weights — the app loads Florence-2 from models/florence2-large-ft/
# (~GBs, MIT-licensed upstream). Fetched separately, never committed.
models/

# Vision analysis outputs — Example/Vision/analyze.py writes the per-image annotated
# image, label mask and descriptions here; the inputs (Image_00*.png and the
# Image_Background_*.png reference) are committed, the regenerated outputs are not.
Data/Camera/Results/

# Session logs — one plain-text file per application run, written by Logger/Core.py.
# A per-run artifact, never committed.
logger/
