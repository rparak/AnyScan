# Python bytecode / caches
__pycache__/
*.py[cod]

# Virtual environments
.venv/
venv/
env/

# macOS
.DS_Store

# Model weights — the app loads Gemma 4 from models/gemma-4-e4b-it-4bit/ (~4.8 GB, Apache
# 2.0, not MIT) and FastSAM from models/FastSAM/. Fetched separately, never committed. Anchored to the
# repo root so it cannot also swallow a nested directory that happens to be named 'models'.
# Its CONTENTS are ignored, not the directory: '/models/' would ignore models/.gitkeep too, which
# then stayed tracked only because it was committed before the rule. The .gitkeep says what to fetch.
/models/*
!/models/.gitkeep

# Tool output — Example/Vision/analyze.py writes each frame's annotated image, label mask
# and descriptions here, and Example/Camera/scan.py its captured frames; regenerated on
# demand, not committed. The inputs (Data/Images/Test/, Data/Images/Background/) are.
/Data/Results/

# Calibration capture sets — Example/Camera/calibrate.py --capture writes a timestamped
# directory of distorted frames (~4 MB each, 20+ a set) and its capture.json here. Kept on
# the rig, not in git; the calibration file records which directory it was solved from.
/Data/Images/Calibration/

# Session logs and per-analysis captures — written by Logger/Core.py and UI/Capture.py
# under the repo-root logger/ directory. A per-run artifact, never committed. Anchored to
# the ROOT with a leading slash: an unanchored 'logger/' matches a directory of that name
# ANYWHERE, so on a case-insensitive filesystem it also ignored the tracked source in
# src/Logger/ and test/Logger/ — 'git add .' skipped them silently. Its contents are ignored,
# not the directory, so logger/.gitkeep is tracked and a fresh clone has the directory.
/logger/*
!/logger/.gitkeep
# The shipped station-event directory (General.Station_Events.Directory) must exist for the shipped
# configuration to load, so the directory is tracked by its .gitkeep; the daily files in it are not.
!/logger/Station_Events/
/logger/Station_Events/*
!/logger/Station_Events/.gitkeep

# Claude Code: its local state (locks, worktrees, checkpoints, ...) stays out; the project's
# skills and its shared settings.json are tracked. Anchored to the repo root like /models/* and
# /logger/* above. It is here, not in .git/info/exclude, so it travels with a copy of the repository.
/.claude/*
!/.claude/skills/
!/.claude/settings.json
